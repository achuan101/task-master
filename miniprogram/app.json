{
  "pages": [
    "pages/index/index",
    "pages/exam/exam",
    "pages/thesis/thesis",
    "pages/mine/mine"
  ],
  "darkmode": true,
  "themeLocation": "theme.json",
  "window": {
    "backgroundTextStyle": "@bgTextStyle",
    "navigationBarBackgroundColor": "@navBgColor",
    "navigationBarTitleText": "MasterPlan 申硕进度",
    "navigationBarTextStyle": "@navTextStyle",
    "backgroundColor": "@bgColor"
  },
  "tabBar": {
    "custom": true,
    "color": "@tabColor",
    "selectedColor": "@tabSelectedColor",
    "backgroundColor": "@tabBgColor",
    "borderStyle": "@tabBorderStyle",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/exam/exam",
        "text": "考试"
      },
      {
        "pagePath": "pages/thesis/thesis",
        "text": "论文"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的"
      }
    ]
  },
  "usingComponents": {
    "t-button": "tdesign-miniprogram/button/button",
    "t-icon": "tdesign-miniprogram/icon/icon",
    "t-progress": "tdesign-miniprogram/progress/progress",
    "t-tag": "tdesign-miniprogram/tag/tag",
    "t-tabs": "tdesign-miniprogram/tabs/tabs",
    "t-tab-panel": "tdesign-miniprogram/tab-panel/tab-panel",
    "t-steps": "tdesign-miniprogram/steps/steps",
    "t-step-item": "tdesign-miniprogram/step-item/step-item",
    "t-toast": "tdesign-miniprogram/toast/toast",
    "t-dialog": "tdesign-miniprogram/dialog/dialog",
    "t-popup": "tdesign-miniprogram/popup/popup",
    "t-cell": "tdesign-miniprogram/cell/cell",
    "t-cell-group": "tdesign-miniprogram/cell-group/cell-group",
    "t-badge": "tdesign-miniprogram/badge/badge",
    "t-skeleton": "tdesign-miniprogram/skeleton/skeleton",
    "t-empty": "tdesign-miniprogram/empty/empty"
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2"
}
