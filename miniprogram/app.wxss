/** app.wxss - MasterPlan 全局设计规范 **/

page {
  --bg-primary: #F8FAFC;       /* 浅灰底色 */
  --bg-secondary: #FFFFFF;     /* 纯白卡片底色 */
  --bg-card: #F1F5F9;          /* 卡片高亮底色 */
  --bg-card-hover: #E2E8F0;    /* 点击悬浮色 */
  
  --text-primary: #0F172A;     /* 深色主文本 */
  --text-secondary: #475569;   /* 次级说明文本 */
  --text-muted: #94A3B8;       /* 弱化文本 */
  
  --accent-cyan: #0EA5E9;      /* 核心青色 */
  --accent-indigo: #4F46E5;    /* 科技靛蓝 */
  --accent-gold: #D97706;      /* 金色 */
  --accent-green: #10B981;     /* 翡翠绿 */
  --accent-rose: #E11D48;      /* 玫瑰红 */
  
  --border-subtle: rgba(0, 0, 0, 0.08);
  --border-focus: rgba(14, 165, 233, 0.35);
  
  --shadow-card: 0 4px 20px -2px rgba(0, 0, 0, 0.05);
  --shadow-glow: 0 0 15px rgba(14, 165, 233, 0.15);

  background-color: var(--bg-primary);
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

@media (prefers-color-scheme: dark) {
  page {
    --bg-primary: #0B1120;
    --bg-secondary: #0F172A;
    --bg-card: #1E293B;
    --bg-card-hover: #334155;
    
    --text-primary: #F8FAFC;
    --text-secondary: #94A3B8;
    --text-muted: #64748B;
    
    --accent-cyan: #38BDF8;
    --accent-indigo: #6366F1;
    --accent-gold: #FBBF24;
    --accent-green: #34D399;
    --accent-rose: #FB7185;
    
    --border-subtle: rgba(255, 255, 255, 0.08);
    --border-focus: rgba(56, 189, 248, 0.35);
    
    --shadow-card: 0 4px 20px -2px rgba(0, 0, 0, 0.5);
    --shadow-glow: 0 0 15px rgba(56, 189, 248, 0.15);
  }
}

/* 页面通用容器 */
.page-container {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 玻璃拟态卡片基础 */
.glass-card {
  background: var(--bg-secondary);
  border: 1px solid var(--border-subtle);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.glass-card:active {
  transform: scale(0.995);
  border-color: var(--border-focus);
}

/* 渐变标题 */
.gradient-text {
  background: linear-gradient(135deg, #38BDF8 0%, #818CF8 50%, #FBBF24 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 700;
}

/* 区块标题与副标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 徽章与标签 */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-badge.passed {
  background: rgba(52, 211, 153, 0.15);
  color: var(--accent-green);
  border: 1px solid rgba(52, 211, 153, 0.3);
}

.status-badge.pending {
  background: rgba(148, 163, 184, 0.12);
  color: var(--text-secondary);
  border: 1px solid rgba(148, 163, 184, 0.2);
}

.status-badge.learning {
  background: rgba(56, 189, 248, 0.15);
  color: var(--accent-cyan);
  border: 1px solid rgba(56, 189, 248, 0.3);
}

.status-badge.danger {
  background: rgba(251, 113, 133, 0.15);
  color: var(--accent-rose);
  border: 1px solid rgba(251, 113, 133, 0.3);
}

.status-badge.gold {
  background: rgba(251, 191, 36, 0.15);
  color: var(--accent-gold);
  border: 1px solid rgba(251, 191, 36, 0.3);
}

/* 通用 flex 工具 */
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}
