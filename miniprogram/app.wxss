/** app.wxss - MasterPlan 全局设计规范 **/

page {
  --bg-primary: #0B1120;       /* 宇宙深蓝底色 */
  --bg-secondary: #0F172A;     /* 卡片深灰底色 */
  --bg-card: #1E293B;          /* 卡片高亮底色 */
  --bg-card-hover: #334155;    /* 点击悬浮色 */
  
  --text-primary: #F8FAFC;     /* 纯净白主文本 */
  --text-secondary: #94A3B8;   /* 柔和灰副文本 */
  --text-muted: #64748B;       /* 弱化说明文本 */
  
  --accent-cyan: #38BDF8;      /* 核心霓虹青 (与 Logo 呼应) */
  --accent-indigo: #6366F1;    /* 科技靛蓝 */
  --accent-gold: #FBBF24;      /* 成就与金牌黄 */
  --accent-green: #34D399;     /* 顺利/通过翡翠绿 */
  --accent-rose: #FB7185;      /* 预警/截止玫瑰红 */
  
  --border-subtle: rgba(255, 255, 255, 0.08);
  --border-focus: rgba(56, 189, 248, 0.35);
  
  --shadow-card: 0 4px 20px -2px rgba(0, 0, 0, 0.5);
  --shadow-glow: 0 0 15px rgba(56, 189, 248, 0.15);

  background-color: #0B1120;
  background-color: var(--bg-primary);
  color: #F8FAFC;
  color: var(--text-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* 页面通用容器 */
.page-container {
  min-height: 100vh;
  padding: 24rpx 32rpx 100rpx;
  box-sizing: border-box;
}

/* 玻璃拟态卡片基础 */
.glass-card {
  background: #0F172A;
  background: var(--bg-secondary);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border: 1px solid var(--border-subtle);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
  transition: all 0.25s ease;
  position: relative;
  overflow: hidden;
}

.glass-card:active {
  transform: scale(0.995);
  border-color: var(--border-focus);
}

/* 渐变标题 */
.gradient-text {
  color: #38BDF8;
  font-weight: 700;
}

/* 区块标题与副标题 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #F8FAFC;
  color: var(--text-primary);
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #64748B;
  color: var(--text-muted);
}

/* 徽章与标签 */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 9999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-badge.passed {
  background: rgba(52, 211, 153, 0.15);
  color: #34D399;
  color: var(--accent-green);
  border: 1px solid rgba(52, 211, 153, 0.3);
}

.status-badge.pending {
  background: rgba(148, 163, 184, 0.12);
  color: #94A3B8;
  color: var(--text-secondary);
  border: 1px solid rgba(148, 163, 184, 0.2);
}

.status-badge.learning {
  background: rgba(56, 189, 248, 0.15);
  color: #38BDF8;
  color: var(--accent-cyan);
  border: 1px solid rgba(56, 189, 248, 0.3);
}

.status-badge.danger {
  background: rgba(251, 113, 133, 0.15);
  color: #FB7185;
  color: var(--accent-rose);
  border: 1px solid rgba(251, 113, 133, 0.3);
}

.status-badge.gold {
  background: rgba(251, 191, 36, 0.15);
  color: #FBBF24;
  color: var(--accent-gold);
  border: 1px solid rgba(251, 191, 36, 0.3);
}

/* 通用 flex 工具 */
.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 页面错误提示（保证即使数据失败也有可见 UI） */
.page-error-banner {
  background: rgba(251, 113, 133, 0.15);
  border: 1px solid rgba(251, 113, 133, 0.35);
  color: #FB7185;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
