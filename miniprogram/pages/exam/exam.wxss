/* miniprogram/pages/exam/exam.wxss */

.exam-summary {
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
}

.sum-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.sum-val {
  font-size: 36rpx;
  font-weight: 700;
}

.sum-val.gold { color: var(--accent-gold); }
.sum-val.cyan { color: var(--accent-cyan); }
.sum-val.green { color: var(--accent-green); }

.summary-divider {
  width: 1px;
  height: 48rpx;
  background: var(--border-subtle);
}



/* 提示警示条 */
.tab-desc-alert {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  background: rgba(251, 191, 36, 0.1);
  border: 1px solid rgba(251, 191, 36, 0.25);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  font-size: 22rpx;
  color: #FDE68A;
  line-height: 1.5;
}

.tab-desc-alert.pool {
  background: rgba(56, 189, 248, 0.1);
  border-color: rgba(56, 189, 248, 0.25);
  color: #BAE6FD;
}

.tab-desc-alert.green {
  background: rgba(52, 211, 153, 0.1);
  border-color: rgba(52, 211, 153, 0.25);
  color: #A7F3D0;
}

/* 类别横向筛选滚动条 */
.category-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
  display: flex;
  gap: 14rpx;
}

.cat-chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  background: var(--bg-secondary);
  border: 1px solid var(--border-subtle);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
}

.cat-chip.active {
  background: rgba(56, 189, 248, 0.15);
  border-color: var(--accent-cyan);
  color: var(--accent-cyan);
  font-weight: 600;
}

/* 考试卡片 */
@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.exam-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  opacity: 0;
  animation: fadeInUp 0.4s ease-out forwards;
}

.exam-card:nth-child(1) { animation-delay: 0.05s; }
.exam-card:nth-child(2) { animation-delay: 0.1s; }
.exam-card:nth-child(3) { animation-delay: 0.15s; }
.exam-card:nth-child(4) { animation-delay: 0.2s; }
.exam-card:nth-child(n+5) { animation-delay: 0.25s; }

.exam-card.card-passed {
  border-color: rgba(52, 211, 153, 0.3);
  background: linear-gradient(135deg, rgba(15, 23, 42, 0.9) 0%, rgba(6, 78, 59, 0.15) 100%);
}

.exam-card-top {
  margin-bottom: 16rpx;
}

.exam-main-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.exam-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}



.course-meta-row {
  margin-bottom: 20rpx;
  font-size: 22rpx;
  color: var(--text-muted);
}

.credit-text {
  font-size: 22rpx;
  color: var(--accent-cyan);
  font-weight: 600;
}

/* 4次机会点阵 */
.chances-row {
  background: rgba(0, 0, 0, 0.2);
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin: 16rpx 0 20rpx;
}

.chances-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.chance-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.dot.remain {
  background: var(--accent-gold);
  box-shadow: 0 0 8rpx rgba(251, 191, 36, 0.5);
}

.dot.used {
  background: rgba(255, 255, 255, 0.15);
}

.remain-text {
  font-size: 20rpx;
  color: var(--accent-gold);
  margin-left: 6rpx;
}

/* 卡片底部与操作按钮 */
.exam-card-footer {
  border-top: 1px solid var(--border-subtle);
  padding-top: 16rpx;
}

.pass-date-meta {
  font-size: 20rpx;
  color: var(--text-muted);
}

.action-btn {
  margin: 0 !important;
  border-radius: 999rpx !important;
  font-size: 22rpx !important;
  padding: 6rpx 24rpx !important;
  font-weight: 600 !important;
}

.btn-pass {
  background: linear-gradient(135deg, #059669 0%, #10B981 100%) !important;
  color: #FFFFFF !important;
  border: none !important;
  box-shadow: 0 2px 10rpx rgba(16, 185, 129, 0.3) !important;
}

.btn-cancel {
  background: rgba(255, 255, 255, 0.08) !important;
  color: var(--text-muted) !important;
  border: 1px solid var(--border-subtle) !important;
}
