/* miniprogram/pages/thesis/thesis.wxss */

/* 1.5年倒计时 Hero */
.countdown-hero {
  padding: 32rpx;
  position: relative;
  overflow: hidden;
}

.countdown-hero.unlocked {
  background: linear-gradient(145deg, #1E1B4B 0%, #0F172A 100%);
  border: 1px solid rgba(251, 113, 133, 0.4);
  box-shadow: 0 0 20rpx rgba(251, 113, 133, 0.2);
}

.countdown-hero.locked {
  background: var(--bg-secondary);
  border: 1px dashed rgba(255, 255, 255, 0.15);
}

.hero-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.countdown-main {
  margin-top: 24rpx;
}

.time-box {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.time-val {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--accent-rose);
  line-height: 1;
}

.time-label {
  font-size: 26rpx;
  color: var(--accent-rose);
  font-weight: 600;
}

.deadline-details {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-line {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.detail-line.highlight {
  color: #FDA4AF;
  font-weight: 600;
}

.locked-body {
  margin-top: 20rpx;
}

.locked-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.locked-tip {
  margin-top: 16rpx;
  background: rgba(56, 189, 248, 0.08);
  border: 1px solid rgba(56, 189, 248, 0.2);
  border-radius: 12rpx;
  padding: 16rpx;
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  font-size: 22rpx;
  color: #BAE6FD;
  line-height: 1.5;
}

/* 小论文卡片 */
.paper-card {
  padding: 28rpx;
}

.paper-rules {
  display: flex;
  gap: 12rpx;
}

.rule-tag {
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-secondary);
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.edit-link {
  font-size: 22rpx;
  color: var(--accent-cyan);
}

.stepper-row {
  display: flex;
  justify-content: space-between;
  margin: 32rpx 0 24rpx;
  position: relative;
}

.stepper-row::before {
  content: "";
  position: absolute;
  top: 14rpx;
  left: 20rpx;
  right: 20rpx;
  height: 4rpx;
  background: rgba(255, 255, 255, 0.1);
  z-index: 1;
}

.step-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  z-index: 2;
}

.node-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--bg-card);
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.2s ease;
}

.node-name {
  font-size: 20rpx;
  color: var(--text-muted);
}

.step-node.selected .node-dot {
  background: var(--accent-cyan);
  border-color: #FFFFFF;
  box-shadow: 0 0 12rpx rgba(56, 189, 248, 0.8);
}

.step-node.selected .node-name {
  color: var(--accent-cyan);
  font-weight: 700;
}

.paper-info-box {
  background: rgba(0, 0, 0, 0.25);
  border-radius: 14rpx;
  padding: 20rpx;
}

.info-row {
  display: flex;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-row .label {
  color: var(--text-muted);
  width: 130rpx;
}

.info-row .val {
  color: var(--text-primary);
  flex: 1;
}

/* 时间轴列表 */
.timeline-container {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.timeline-item {
  margin-bottom: 0;
  padding: 28rpx;
}

.timeline-item.item-completed {
  border-color: rgba(52, 211, 153, 0.4);
  background: linear-gradient(135deg, #0F172A 0%, rgba(6, 78, 59, 0.2) 100%);
}

.timeline-left {
  display: flex;
  gap: 20rpx;
}

.step-num-circle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.step-num-circle.done {
  background: var(--accent-green);
  color: #064E3B;
  border-color: var(--accent-green);
}

.step-info {
  flex: 1;
}

.step-title-row {
  margin-bottom: 8rpx;
}

.step-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.step-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.step-tag.passed {
  background: rgba(52, 211, 153, 0.15);
  color: var(--accent-green);
}

.step-tag.pending {
  background: rgba(255, 255, 255, 0.08);
  color: var(--text-muted);
}

.step-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.step-meta {
  margin-top: 12rpx;
}

.done-date {
  font-size: 20rpx;
  color: var(--accent-green);
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
  padding: 40rpx;
}

.modal-card {
  width: 100%;
  background: #1E293B;
  border: 1px solid rgba(56, 189, 248, 0.3);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 28rpx;
}

.close-icon {
  font-size: 32rpx;
  color: var(--text-muted);
  padding: 8rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
  display: block;
}

.custom-input {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--border-subtle);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.modal-actions {
  margin-top: 36rpx;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  font-size: 26rpx !important;
  border-radius: 999rpx !important;
}

.modal-btn.cancel {
  background: rgba(255, 255, 255, 0.08) !important;
  color: var(--text-secondary) !important;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #0284C7 0%, #38BDF8 100%) !important;
  color: #FFFFFF !important;
}
