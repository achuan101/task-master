<!-- miniprogram/pages/index/index.wxml -->

<!-- 新用户引导弹窗 -->
<view class="onboarding-overlay" wx:if="{{showOnboarding}}">
  <view class="onboarding-card">
    <view class="onboarding-logo">🎓</view>
    <text class="onboarding-title">欢迎使用 MasterPlan</text>
    <text class="onboarding-desc">同等学力申硕备考规划助手\n请先选择你的专业方向</text>

    <view class="onboarding-majors">
      <block wx:for="{{majorList}}" wx:key="key">
        <view class="major-option {{selectedMajor === item.key ? 'active' : ''}}" bindtap="selectMajor" data-key="{{item.key}}">
          <view class="major-option-left">
            <text class="major-option-icon">{{item.icon}}</text>
            <view class="major-option-info">
              <text class="major-option-name">{{item.majorName}}</text>
              <text class="major-option-school">{{item.school}}</text>
            </view>
          </view>
          <view class="major-option-check" wx:if="{{selectedMajor === item.key}}">✓</view>
        </view>
      </block>
    </view>

    <view class="onboarding-dates">
      <view class="date-field">
        <text class="date-label">入学时间</text>
        <picker mode="date" value="{{onboardEnrollDate}}" start="2020-01-01" end="2030-12-31" bindchange="onOnboardEnrollChange">
          <view class="date-picker">{{onboardEnrollDate}}</view>
        </picker>
      </view>
    </view>

    <button class="onboarding-btn" bindtap="confirmOnboarding" disabled="{{!selectedMajor}}">开始规划我的申硕之路</button>
  </view>
</view>

<view class="page-container">
  <!-- 1. 顶栏欢迎区 -->
  <view class="header-section flex-between">
    <view class="user-intro">
      <view class="app-title-row">
        <text class="app-name">MasterPlan</text>
        <text class="app-tag">同等学力申硕</text>
      </view>
      <view class="user-sub">
        <text class="major-badge">{{user.majorName || ''}}</text>
        <text class="school-name">信息学院</text>
      </view>
    </view>
    <image class="header-logo" src="/assets/logo.jpg" mode="aspectFill" bindtap="navigateToSettings"></image>
  </view>

  <!-- 2. 4年进度线 Hero Card -->
  <view class="glass-card lifeline-card">
    <view class="lifeline-header flex-between">
      <view class="lifeline-title">
        <t-icon name="time" size="32rpx" color="var(--text-secondary)" />
        <text style="margin-left:8rpx;">4年进度线</text>
      </view>
      <view class="status-badge {{lifeline.status}}">
        {{lifeline.statusText}}
      </view>
    </view>

    <view class="lifeline-body">
      <view class="countdown-display">
        <text class="days-num">{{lifeline.remainingDays}}</text>
        <text class="days-unit">天剩余</text>
      </view>
      <view class="timeline-meta">
        <text>目标截止：{{lifeline.deadlineFormatted}} (共{{lifeline.totalDays}}天)</text>
      </view>

      <!-- 进度条 -->
      <view class="progress-wrapper">
        <t-progress percentage="{{lifeline.percentage}}" color="var(--accent-cyan)" trackColor="var(--border-subtle)" strokeWidth="12" />
        <view class="progress-label flex-between">
          <text>已消耗 {{lifeline.elapsedDays}} 天</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 3. 四大核心支柱进度矩阵 (2x2) -->
  <view class="section-header">
    <view class="section-title">
      <t-icon name="chart-bar" size="36rpx" color="var(--text-primary)" />
      <text style="margin-left:8rpx;">核心阶段攻坚盘</text>
    </view>
    <text class="section-subtitle">点击直达各模块打卡</text>
  </view>

  <view class="pillars-grid">
    <!-- 支柱 1: 课程考试 -->
    <view class="pillar-card" bindtap="navigateToExam">
      <view class="pillar-top flex-between">
        <text class="pillar-title">课程学分</text>
        <t-tag variant="light-outline" theme="default">{{stats.passedCourses}}/{{stats.totalCourses}}门</t-tag>
      </view>
      <view class="pillar-value flex-between" style="align-items: center; margin-top: 20rpx;">
        <view>
          <text class="big-num">{{stats.earnedCredits}}</text>
          <text class="unit-text">/{{stats.totalCredits}} 学分</text>
        </view>
        <t-progress type="circle" percentage="{{stats.courseProgress}}" color="#0EA5E9" trackColor="rgba(14, 165, 233, 0.15)" strokeWidth="8" style="--td-progress-circle-size: 80rpx;" />
      </view>
      <view class="pillar-footer">
        <text>{{stats.poolTotal}}门题库 + {{stats.nonPoolTotal}}门非题库</text>
      </view>
    </view>

    <!-- 支柱 2: 国家统考 -->
    <view class="pillar-card" bindtap="navigateToExam">
      <view class="pillar-top flex-between">
        <text class="pillar-title">国家统考</text>
        <t-tag variant="light-outline" theme="warning">5月统考</t-tag>
      </view>
      <view class="pillar-value">
        <text class="big-num">{{stats.passedExams}}</text>
        <text class="unit-text">/{{stats.totalExams}} 门已过</text>
      </view>
      <view class="pillar-footer exam-hint">
        <text>学科综合 + 外语 (共4次机会)</text>
      </view>
    </view>

    <!-- 支柱 3: 学术小论文 -->
    <view class="pillar-card" bindtap="navigateToThesis">
      <view class="pillar-top flex-between">
        <text class="pillar-title">学术小论文</text>
        <t-tag variant="light-outline" theme="primary">前置卡点</t-tag>
      </view>
      <view class="pillar-value">
        <t-tag theme="{{stats.paperPassed ? 'success' : 'primary'}}" variant="light">{{stats.paperStatusText}}</t-tag>
      </view>
      <view class="pillar-footer">
        <text>答辩前需公开发表≥3000字</text>
      </view>
    </view>

    <!-- 支柱 4: 学位大论文 -->
    <view class="pillar-card" bindtap="navigateToThesis">
      <view class="pillar-top flex-between">
        <text class="pillar-title">学位大论文</text>
        <t-tag variant="light-outline" theme="primary">1.5年时限</t-tag>
      </view>
      <view class="pillar-value">
        <block wx:if="{{stats.thesisCountdown}}">
          <text class="countdown-warning">{{stats.thesisCountdown.remainingDays}}天</text>
        </block>
        <block wx:else>
          <t-tag theme="default" variant="light">待考完全部激活</t-tag>
        </block>
      </view>
      <view class="pillar-footer">
        <text>当前：{{stats.thesisStageText}}</text>
      </view>
    </view>
  </view>

  <!-- 4. 近期重要日程 (Upcoming Calendar) -->
  <view class="section-header">
    <view class="section-title">
      <t-icon name="calendar" size="36rpx" color="var(--text-primary)" />
      <text style="margin-left:8rpx;">年度备考关键窗口</text>
    </view>
    <text class="section-subtitle">按时间先后排序</text>
  </view>

  <view class="events-list">
    <block wx:if="{{upcomingEvents.length > 0}}">
      <block wx:for="{{upcomingEvents}}" wx:key="id">
        <view class="event-item glass-card">
          <view class="event-left">
            <view class="event-tag-box {{item.type}}">
              <text>{{item.tag}}</text>
            </view>
            <view class="event-info">
              <text class="event-title">{{item.title}}</text>
              <text class="event-desc">{{item.desc}}</text>
            </view>
          </view>
          <view class="event-right">
            <view class="days-badge">
              <text class="days-prefix">还有</text>
              <text class="days-count">{{item.daysLeft}}</text>
              <text class="days-suffix">天</text>
            </view>
            <text class="event-date">{{item.targetDate}}</text>
          </view>
        </view>
      </block>
    </block>
    <block wx:else>
      <view style="padding: 40rpx 0;">
        <t-empty icon="calendar" description="近期暂无考核与日程，好好休息吧！" />
      </view>
    </block>
  </view>

</view>
